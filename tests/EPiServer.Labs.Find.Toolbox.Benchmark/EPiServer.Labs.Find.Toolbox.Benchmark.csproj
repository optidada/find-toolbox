<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance benchmark against a TEST Find index (see README "Performance"). Not part of CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Sequential timing tool: Find's sync methods are fine here -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EPiServer.Labs.Find.Toolbox\EPiServer.Labs.Find.Toolbox.csproj" />
  </ItemGroup>
</Project>
