<?xml version="1.0" encoding="utf-8"?>
<!--
  Alloy MVC (CMS 11, Find 13.6.1, .NET Framework 4.8) test site for the Find Toolbox.
  Built from the Alloy MVC template of the Episerver CMS Visual Studio Extension 11.7 (Alloy.Mvc.Template.Sources 1.2.0).
  Build with Visual Studio / MSBuild (not dotnet build: it is a classic ASP.NET web application). Run with IIS Express.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6F1C3C55-7A1E-4C59-9C0B-2B7B7C1E1A11}</ProjectGuid>
    <ProjectTypeGuids>{349c5851-65df-11da-9384-00065b846f21};{fae04ec0-301f-11d3-bf4b-00c04f79efbc}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>AlloyCms11</RootNamespace>
    <AssemblyName>AlloyCms11</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <MvcBuildViews>false</MvcBuildViews>
    <UseIISExpress>true</UseIISExpress>
    <IISExpressSSLPort />
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <OutputPath>bin\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;NETFRAMEWORK;NET48</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Abstractions" />
    <Reference Include="System.Web.ApplicationServices" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web.Routing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="11.21.4" />
    <PackageReference Include="EPiServer.CMS.UI" Version="11.37.5" />
    <PackageReference Include="EPiServer.CMS.UI.AspNetIdentity" Version="11.37.5" />
    <PackageReference Include="EPiServer.CMS.TinyMce" Version="2.13.8" />
    <PackageReference Include="EPiServer.ServiceLocation.StructureMap" Version="2.0.3" />
    <PackageReference Include="EPiServer.Find.Cms" Version="13.6.1" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Optidada.SearchNavigation.Toolbox\Optidada.SearchNavigation.Toolbox.csproj">
      <Project>{00000000-0000-0000-0000-000000000000}</Project>
      <Name>Optidada.SearchNavigation.Toolbox</Name>
      <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;modules\**" />
    <!-- Test harness shared with the CMS 12 site -->
    <Compile Include="..\Shared\ToolboxTestHarness\**\*.cs" Link="ToolboxTestHarness\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Global.asax" />
    <Content Include="Web.config" />
    <Content Include="Views\**\*.cshtml" />
    <Content Include="Views\Web.config" />
  </ItemGroup>

  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\WebApplications\Microsoft.WebApplication.targets" />

  <!--
    With PackageReference the package install scripts/content do not run, so do what they did:
    copy the CMS UI modules from the packages and seed an empty CMS database.
  -->
  <Target Name="CopyEpiserverModules" BeforeTargets="Build">
    <ItemGroup>
      <EpiModule Include="$(NuGetPackageRoot)episerver.cms.ui\11.37.5\content\modules\_protected\**\*" />
      <EpiModule Include="$(NuGetPackageRoot)episerver.cms.tinymce\2.13.8\content\modules\_protected\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EpiModule)" DestinationFiles="@(EpiModule->'$(MSBuildProjectDirectory)\modules\_protected\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="SeedDatabase" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\App_Data\AlloyCms11.mdf')">
    <Copy SourceFiles="$(NuGetPackageRoot)episerver.cms\11.21.4\tools\EPiServer.Cms.mdf" DestinationFiles="$(MSBuildProjectDirectory)\App_Data\AlloyCms11.mdf" />
  </Target>

  <Target Name="CheckFindConfig" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\episerver.find.config')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\episerver.find.config.template" DestinationFiles="$(MSBuildProjectDirectory)\episerver.find.config" />
    <Warning Text="Created episerver.find.config from the template: fill in your Search &amp; Navigation index (it is git-ignored)." />
  </Target>
</Project>
